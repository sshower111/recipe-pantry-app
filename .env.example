# Copy to .env and adjust. All variables are optional.
RECIPE_DATA_DIR=data
# RECIPE_DB_PATH=data/recipes.db

RECIPE_OLLAMA_URL=http://localhost:11434
RECIPE_OLLAMA_MODEL=qwen2.5:7b
RECIPE_OLLAMA_TIMEOUT=180
RECIPE_OLLAMA_NUM_CTX=8192
# Disable reasoning on thinking models (qwen3.x etc.); "default" leaves it to the model
RECIPE_OLLAMA_THINK=false

# Whisper: tiny | base | small | medium | large-v3 | distil-large-v3
RECIPE_WHISPER_MODEL=small
# cpu | cuda | auto  (cuda needs cuBLAS + cuDNN installed)
RECIPE_WHISPER_DEVICE=cpu
# int8 for CPU, float16 for GPU
RECIPE_WHISPER_COMPUTE_TYPE=int8

RECIPE_PREFER_CAPTIONS=true
RECIPE_CAPTION_LANGS=en,en-orig,en-US,en-GB
RECIPE_MAX_TRANSCRIPT_CHARS=12000
RECIPE_KEEP_MEDIA=false

# OCR of on-screen text (needs: pip install -r requirements-ocr.txt)
# auto = only when description + speech give fewer than 3 ingredients or no amounts;
# always = every video; off = never
RECIPE_OCR=auto
RECIPE_OCR_LANGS=en
RECIPE_OCR_GPU=false
# Frames sampled per second (near-duplicate frames are dropped) and the cap per video
RECIPE_OCR_FPS=1
RECIPE_OCR_MAX_FRAMES=60

# Ignored when scoring pantry matches (comma-separated, normalized automatically)
RECIPE_PANTRY_STAPLES=salt,black pepper,water,oil
